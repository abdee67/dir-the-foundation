# Supabase project URL — Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key — safe for client-side use, respects RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only, bypasses RLS, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of this app — used for auth redirects and absolute links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Slug of the single store org (e.g. "my-store"). Must match the slug in the orgs table.
# This is used by the flat storefront routing to resolve the single store.
NEXT_PUBLIC_STORE_SLUG=

# Drop lifecycle scheduler. Vercel Cron automatically sends CRON_SECRET as a
# Bearer token; another scheduler can use DROP_CRON_SECRET. Never expose either.
CRON_SECRET=
DROP_CRON_SECRET=

# Optional transactional provider for waitlist launch notifications.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
